{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": "https://<canonical-host>/#organization",
      "name": "<站点名>",
      "url": "https://<canonical-host>/",
      "logo": {
        "@type": "ImageObject",
        "url": "https://<canonical-host>/logo.png"
      },
      "sameAs": [
        "https://github.com/<user>",
        "https://space.bilibili.com/<uid>"
      ]
    },
    {
      "@type": "WebSite",
      "@id": "https://<canonical-host>/#website",
      "name": "<站点名>",
      "url": "https://<canonical-host>/",
      "publisher": { "@id": "https://<canonical-host>/#organization" },
      "inLanguage": "<inLanguage: 站点主语言，按实际填写 —— 中文站 zh-CN / 英文站 en / 多语站见 hreflang 方案>",
      "potentialAction": {
        "@type": "SearchAction",
        "target": "https://<canonical-host>/search?q={search_term_string}",
        "query-input": "required name=search_term_string"
      }
    }
  ]
}
